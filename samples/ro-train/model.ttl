@prefix : <urn:example:ro-train/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix quantitykind: <http://qudt.org/vocab/quantitykind/> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s223: <http://data.ashrae.org/standard223#> .
@prefix unit: <http://qudt.org/vocab/unit/> .
@prefix watr: <https://watermetadata.org/ontology/watr#> .

<urn:example:ro-train> a owl:Ontology ;
    rdfs:label "Brackish water RO train (sample)" ;
    owl:imports <https://watermetadata.org/ontology/0.2/watr> .

:AT-101.sensor a watr:pHSensor ;
    rdfs:label "AT-101 sensor" ;
    s223:hasObservationLocation :P-101 ;
    s223:observes :AT-101 .

:CT-101.sensor a watr:ConductivitySensor ;
    rdfs:label "CT-101 sensor" ;
    s223:hasObservationLocation :RO-1 ;
    s223:observes :CT-101 .

:CT-201.sensor a watr:ConductivitySensor ;
    rdfs:label "CT-201 sensor" ;
    s223:hasObservationLocation :RO-1 ;
    s223:observes :CT-201 .

:FT-201.sensor a watr:FlowSensor ;
    rdfs:label "FT-201 sensor" ;
    s223:hasObservationLocation :P-201 ;
    s223:observes :FT-201 .

:FT-301.sensor a watr:FlowSensor ;
    rdfs:label "FT-301 sensor" ;
    s223:hasObservationLocation :P-201 ;
    s223:observes :FT-301 .

:L-01 a s223:Pipe ;
    rdfs:label "L-01" ;
    s223:cnx :L-01.in,
        :L-01.out ;
    s223:hasMedium watr:Water-Brackish .

:L-02 a s223:Pipe ;
    rdfs:label "L-02" ;
    s223:cnx :L-02.in,
        :L-02.out ;
    s223:hasMedium watr:Water-Brackish .

:L-03 a s223:Pipe ;
    rdfs:label "L-03" ;
    s223:cnx :L-03.in,
        :L-03.out ;
    s223:hasMedium watr:Water-Brackish .

:L-04 a s223:Pipe ;
    rdfs:label "L-04" ;
    s223:cnx :L-04.in,
        :L-04.out ;
    s223:hasMedium watr:Water-Brackish .

:L-05 a s223:Pipe ;
    rdfs:label "L-05" ;
    s223:cnx :L-05.in,
        :L-05.out ;
    s223:hasMedium watr:Water-Freshwater .

:L-06 a s223:Pipe ;
    rdfs:label "L-06" ;
    s223:cnx :L-06.in,
        :L-06.out ;
    s223:hasMedium watr:Water-Brine .

:LT-101.sensor a watr:LevelSensor ;
    rdfs:label "LT-101 sensor" ;
    s223:hasObservationLocation :TK-101 ;
    s223:observes :LT-101 .

:LT-201.sensor a watr:LevelSensor ;
    rdfs:label "LT-201 sensor" ;
    s223:hasObservationLocation :TK-201 ;
    s223:observes :LT-201 .

:P-101-STS.sensor a s223:Sensor ;
    rdfs:label "P-101-STS sensor" ;
    s223:hasObservationLocation :P-101 ;
    s223:observes :P-101-STS .

:PDT-101.sensor a s223:PressureSensor ;
    rdfs:label "PDT-101 sensor" ;
    s223:hasObservationLocation :CF-101 ;
    s223:observes :PDT-101 .

:PT-101.sensor a s223:PressureSensor ;
    rdfs:label "PT-101 sensor" ;
    s223:hasObservationLocation :P-101 ;
    s223:observes :PT-101 .

:PT-201.sensor a s223:PressureSensor ;
    rdfs:label "PT-201 sensor" ;
    s223:hasObservationLocation :P-201 ;
    s223:observes :PT-201 .

:TK-301 a watr:Tank ;
    rdfs:label "TK-301 Concentrate Tank" .

:TT-101.sensor a s223:TemperatureSensor ;
    rdfs:label "TT-101 sensor" ;
    s223:hasObservationLocation :TK-101 ;
    s223:observes :TT-101 .

:CF-101 a watr:CartridgeFiltrationUnit ;
    rdfs:label "CF-101 Cartridge Filter" ;
    s223:hasConnectionPoint :L-02.in,
        :L-03.out ;
    s223:hasProperty :PDT-101 ;
    watr:hasProcess watr:Process-Filtration .

:TK-201 a watr:Tank ;
    rdfs:label "TK-201 Permeate Tank" ;
    s223:hasConnectionPoint :L-05.in,
        :L-06.in ;
    s223:hasProperty :LT-201 .

:AT-101 a s223:QuantifiableObservableProperty ;
    rdfs:label "AT-101" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:Acidity ;
    qudt:hasUnit unit:PH .

:CT-101 a s223:QuantifiableObservableProperty ;
    rdfs:label "CT-101" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:ElectrolyticConductivity ;
    qudt:hasUnit unit:MicroS-PER-CentiM .

:CT-201 a s223:QuantifiableObservableProperty ;
    rdfs:label "CT-201" ;
    s223:ofMedium watr:Water-Freshwater ;
    qudt:hasQuantityKind quantitykind:ElectrolyticConductivity ;
    qudt:hasUnit unit:MilliGM-PER-L .

:FT-201 a s223:QuantifiableObservableProperty ;
    rdfs:label "FT-201" ;
    s223:ofMedium watr:Water-Freshwater ;
    qudt:hasQuantityKind quantitykind:VolumeFlowRate ;
    qudt:hasUnit unit:GAL_US-PER-MIN .

:FT-301 a s223:QuantifiableObservableProperty ;
    rdfs:label "FT-301" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:VolumeFlowRate ;
    qudt:hasUnit unit:GAL_US-PER-MIN .

:L-01.in a s223:InletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-01.out a s223:OutletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-02.in a s223:InletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-02.out a s223:OutletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-03.in a s223:InletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-03.out a s223:OutletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-04.in a s223:InletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-04.out a s223:OutletConnectionPoint ;
    s223:hasMedium watr:Water-Brackish .

:L-05.in a s223:InletConnectionPoint ;
    s223:hasMedium watr:Water-Freshwater .

:L-05.out a s223:OutletConnectionPoint ;
    s223:hasMedium watr:Water-Freshwater .

:L-06.in a s223:InletConnectionPoint ;
    s223:hasMedium watr:Water-Brine .

:L-06.out a s223:OutletConnectionPoint ;
    s223:hasMedium watr:Water-Brine .

:LT-101 a s223:QuantifiableObservableProperty ;
    rdfs:label "LT-101" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:Length ;
    qudt:hasUnit unit:FT .

:LT-201 a s223:QuantifiableObservableProperty ;
    rdfs:label "LT-201" ;
    s223:ofMedium watr:Water-Freshwater ;
    qudt:hasQuantityKind quantitykind:Length ;
    qudt:hasUnit unit:FT .

:P-101-CMD a s223:EnumeratedActuatableProperty ;
    rdfs:label "P-101-CMD" ;
    s223:hasEnumerationKind s223:Binary-OnOff .

:P-101-STS a s223:EnumeratedObservableProperty ;
    rdfs:label "P-101-STS" ;
    s223:hasEnumerationKind s223:Binary-OnOff .

:P-201-SPD a s223:QuantifiableActuatableProperty ;
    rdfs:label "P-201-SPD" ;
    qudt:hasQuantityKind quantitykind:DimensionlessRatio ;
    qudt:hasUnit unit:PERCENT .

:PDT-101 a s223:QuantifiableObservableProperty ;
    rdfs:label "PDT-101" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PSI .

:PT-101 a s223:QuantifiableObservableProperty ;
    rdfs:label "PT-101" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PSI .

:PT-201 a s223:QuantifiableObservableProperty ;
    rdfs:label "PT-201" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:Pressure ;
    qudt:hasUnit unit:PSI .

:RO-1 a watr:ReverseOsmosisMembrane ;
    rdfs:label "RO-1 Reverse Osmosis Skid" ;
    s223:hasConnectionPoint :L-04.in,
        :L-05.out,
        :L-06.out ;
    s223:hasProperty :CT-101,
        :CT-201 ;
    watr:hasProcess watr:Process-ReverseOsmosis .

:TK-101 a watr:Tank ;
    rdfs:label "TK-101 Raw Water Tank" ;
    s223:hasConnectionPoint :L-01.out ;
    s223:hasProperty :LT-101,
        :TT-101 .

:TT-101 a s223:QuantifiableObservableProperty ;
    rdfs:label "TT-101" ;
    s223:ofMedium watr:Water-Brackish ;
    qudt:hasQuantityKind quantitykind:Temperature ;
    qudt:hasUnit unit:DEG_C .

:P-101 a watr:Pump ;
    rdfs:label "P-101 Feed Pump" ;
    s223:actuatedByProperty :P-101-CMD ;
    s223:hasConnectionPoint :L-01.in,
        :L-02.out ;
    s223:hasProperty :AT-101,
        :P-101-CMD,
        :P-101-STS,
        :PT-101 .

:P-201 a watr:Pump ;
    rdfs:label "P-201 High Pressure Pump" ;
    s223:actuatedByProperty :P-201-SPD ;
    s223:hasConnectionPoint :L-03.in,
        :L-04.out ;
    s223:hasProperty :FT-201,
        :FT-301,
        :P-201-SPD,
        :PT-201 .
